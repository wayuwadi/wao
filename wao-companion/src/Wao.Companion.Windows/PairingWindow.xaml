<Window x:Class="Wao.Companion.Windows.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接 WAO 桌面宠物" Width="520" Height="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8F7FC" FontFamily="Segoe UI">
  <Grid Margin="34">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <Border Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Left" Background="#6C50D8">
        <TextBlock Text="W" Foreground="White" FontWeight="Bold" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="连接 WAO Companion" FontSize="25" FontWeight="SemiBold" Foreground="#262238" Margin="0,18,0,7"/>
      <TextBlock Text="桌宠只会读取你自己的 AI Run 状态，不会获得任务编辑、密钥库或 Runner 权限。"
                 TextWrapping="Wrap" Foreground="#6C687A" LineHeight="22"/>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,24,0,22" Padding="24" CornerRadius="18" Background="White" BorderBrush="#E6E2F1" BorderThickness="1">
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="正在创建安全配对码…" TextAlignment="Center" Foreground="#6C687A"/>
        <TextBlock x:Name="CodeText" Text="••••-••••" FontFamily="Consolas" FontSize="34" FontWeight="Bold"
                   Foreground="#6248CF" TextAlignment="Center" Margin="0,18,0,18"/>
        <Button x:Name="OpenButton" Content="在 WAO 网页确认" HorizontalAlignment="Center" Background="#6C50D8" Foreground="White"
                IsEnabled="False" Click="OpenButton_Click"/>
        <TextBlock x:Name="HintText" Text="配对码十分钟有效；网页会显示这台电脑的名称供你核对。"
                   TextAlignment="Center" TextWrapping="Wrap" Foreground="#8B8698" FontSize="12" Margin="0,15,0,0"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2">
      <TextBlock Text="关闭窗口后应用仍保留在系统托盘。" Foreground="#8B8698" FontSize="12" VerticalAlignment="Center"/>
      <Button x:Name="RetryButton" Content="重新生成" HorizontalAlignment="Right" Visibility="Collapsed" Click="RetryButton_Click"/>
    </Grid>
  </Grid>
</Window>
