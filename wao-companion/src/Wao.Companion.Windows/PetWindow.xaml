<Window x:Class="Wao.Companion.Windows.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAO Companion 桌宠" Width="205" Height="235" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="打开 WAO" Click="OpenWao_Click"/>
      <MenuItem Header="立即刷新" Click="Refresh_Click"/>
      <Separator/>
      <MenuItem x:Name="StartupItem" Header="开机启动" IsCheckable="True" Click="Startup_Click"/>
      <MenuItem Header="隐藏桌宠" Click="Hide_Click"/>
      <MenuItem Header="重新配对" Click="RePair_Click"/>
      <Separator/>
      <MenuItem Header="退出 WAO Companion" Click="Exit_Click"/>
    </ContextMenu>
  </Window.ContextMenu>
  <Grid x:Name="DragSurface" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
    <Border x:Name="Bubble" MaxWidth="188" Padding="10,7" CornerRadius="13"
            Background="#FAFFFFFF" BorderBrush="#E7E1F5" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
      <Border.Effect><DropShadowEffect BlurRadius="16" Opacity="0.18" ShadowDepth="2"/></Border.Effect>
      <StackPanel>
        <TextBlock x:Name="MessageText" Text="今天也一起把事情做好。" TextWrapping="Wrap"
                   TextAlignment="Center" FontFamily="Segoe UI" FontSize="11.5" Foreground="#373247" MaxHeight="43"/>
        <TextBlock x:Name="StateText" Text="空闲陪伴" TextAlignment="Center" FontFamily="Segoe UI"
                   FontSize="10.5" Foreground="#817A92" Margin="0,3,0,0"/>
      </StackPanel>
    </Border>

    <Grid Width="170" Height="165" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.78">
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1"/>
          <RotateTransform x:Name="PetRotate" Angle="0"/>
          <TranslateTransform x:Name="PetMove" X="0" Y="0"/>
        </TransformGroup>
      </Grid.RenderTransform>
      <Ellipse Width="72" Height="11" Fill="#200E0824" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
      <Rectangle Width="148" Height="148" VerticalAlignment="Bottom" Margin="0,0,0,5"
                 RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True">
        <Rectangle.Fill>
          <ImageBrush x:Name="PetBrush" ImageSource="/Assets/wao-pixel-flame-sprites-v3.png"
                      ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0,0.25,0.3333333333" Stretch="Uniform"/>
        </Rectangle.Fill>
      </Rectangle>
      <Border x:Name="UnreadBadge" MinWidth="24" Height="24" CornerRadius="12" Padding="6,0"
              Background="#E85866" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,9,10,0" Visibility="Collapsed">
        <TextBlock x:Name="UnreadText" Text="1" Foreground="White" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
      </Border>
    </Grid>
  </Grid>
</Window>
