<Window x:Class="Wao.Companion.Windows.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="230" Height="260" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="打开 WAO" Click="OpenWao_Click"/>
      <MenuItem Header="立即刷新" Click="Refresh_Click"/>
      <Separator/>
      <MenuItem x:Name="StartupItem" Header="开机启动" IsCheckable="True" Click="Startup_Click"/>
      <MenuItem Header="隐藏桌宠" Click="Hide_Click"/>
      <MenuItem Header="重新配对" Click="RePair_Click"/>
      <Separator/>
      <MenuItem Header="退出 WAO Companion" Click="Exit_Click"/>
    </ContextMenu>
  </Window.ContextMenu>
  <Grid x:Name="DragSurface" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
    <Border x:Name="Bubble" MaxWidth="214" Padding="12,8" CornerRadius="14"
            Background="#FAFFFFFF" BorderBrush="#E7E1F5" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
      <Border.Effect><DropShadowEffect BlurRadius="16" Opacity="0.18" ShadowDepth="2"/></Border.Effect>
      <StackPanel>
        <TextBlock x:Name="MessageText" Text="今天也一起把事情做好。" TextWrapping="Wrap"
                   TextAlignment="Center" FontFamily="Segoe UI" FontSize="12.5" Foreground="#373247" MaxHeight="48"/>
        <TextBlock x:Name="StateText" Text="空闲陪伴" TextAlignment="Center" FontFamily="Segoe UI"
                   FontSize="10.5" Foreground="#817A92" Margin="0,3,0,0"/>
      </StackPanel>
    </Border>

    <Grid Width="198" Height="190" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.78">
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1"/>
          <RotateTransform x:Name="PetRotate" Angle="0"/>
          <TranslateTransform x:Name="PetMove" X="0" Y="0"/>
        </TransformGroup>
      </Grid.RenderTransform>
      <Ellipse Width="116" Height="20" Fill="#220E0824" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
      <Rectangle Width="190" Height="180" VerticalAlignment="Bottom">
        <Rectangle.Fill>
          <ImageBrush x:Name="PetBrush" ImageSource="/Assets/wao-pet-sprites.png"
                      ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0,0.2,1" Stretch="Uniform"/>
        </Rectangle.Fill>
      </Rectangle>
      <Border x:Name="UnreadBadge" MinWidth="28" Height="28" CornerRadius="14" Padding="7,0"
              Background="#E85866" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,10,12,0" Visibility="Collapsed">
        <TextBlock x:Name="UnreadText" Text="1" Foreground="White" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
      </Border>
    </Grid>
  </Grid>
</Window>
