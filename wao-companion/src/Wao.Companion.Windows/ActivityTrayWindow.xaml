<Window x:Class="Wao.Companion.Windows.ActivityTrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAO Companion 活动" Width="380" Height="440" WindowStyle="None" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True">
  <Border CornerRadius="18" Background="#FCFFFFFF" BorderBrush="#E3DDEF" BorderThickness="1" Padding="16">
    <Border.Effect><DropShadowEffect BlurRadius="25" Opacity="0.22" ShadowDepth="5"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <StackPanel>
          <TextBlock Text="WAO 活动" FontSize="18" FontWeight="SemiBold" Foreground="#29243B"/>
          <TextBlock x:Name="SummaryText" Text="没有需要处理的活动" Foreground="#817A92" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
        <Button x:Name="ReadAllButton" Content="全部已读" HorizontalAlignment="Right" VerticalAlignment="Center"
                Padding="10,6" Click="ReadAll_Click"/>
      </Grid>
      <ScrollViewer Grid.Row="1" Margin="0,14,0,10" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <ItemsControl x:Name="ActivityItems">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Background="Transparent" Padding="0" Margin="0,0,0,8" HorizontalContentAlignment="Stretch"
                        Tag="{Binding Activity}" Click="Activity_Click">
                  <Border CornerRadius="12" BorderBrush="#ECE8F3" BorderThickness="1" Padding="12" Background="#FAF9FD">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Background="{Binding Accent}" CornerRadius="4" Margin="0,2,0,2"/>
                      <StackPanel Grid.Column="1" Margin="11,0,0,0">
                        <Grid>
                          <TextBlock Text="{Binding Activity.Title}" FontWeight="SemiBold" Foreground="#322D43" TextTrimming="CharacterEllipsis" Margin="0,0,74,0"/>
                          <Border HorizontalAlignment="Right" Background="{Binding BadgeBackground}" CornerRadius="8" Padding="7,3">
                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding Accent}" FontSize="10.5" FontWeight="SemiBold"/>
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding Activity.ProjectName}" Foreground="#817A92" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Activity.Message}" Foreground="#5F596D" FontSize="11.5" TextWrapping="Wrap" MaxHeight="38" Margin="0,5,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" Margin="0,70,0,0">
            <TextBlock Text="✦" FontSize="30" Foreground="#8D70E8" TextAlignment="Center"/>
            <TextBlock Text="小怪兽正在安静陪伴" Foreground="#817A92" Margin="0,8,0,0"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Text="选择活动后会在浏览器中打开对应 WAO 任务" Foreground="#9892A3" FontSize="10.5" TextAlignment="Center"/>
    </Grid>
  </Border>
</Window>
