{
  "name": "wao-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:dino": "vite --config games/dino/vite.config.ts",
    "build:dino": "vue-tsc --noEmit -p games/dino/tsconfig.json && vite build --config games/dino/vite.config.ts",
    "test:dino": "vitest run --config games/dino/vite.config.ts",
    "lint:dino": "oxlint games/dino host protocol --deny-warnings",
    "dev:rift": "vite --config games/rift/vite.config.ts",
    "build:rift": "vue-tsc --noEmit -p games/rift/tsconfig.json && vite build --config games/rift/vite.config.ts",
    "test:rift": "vitest run --config games/rift/vite.config.ts",
    "lint:rift": "oxlint games/rift --deny-warnings",
    "dev:starfield": "vite --config games/starfield/vite.config.ts",
    "build:starfield": "vue-tsc --noEmit -p games/starfield/tsconfig.json && vite build --config games/starfield/vite.config.ts",
    "test:starfield": "vitest run --config games/starfield/vite.config.ts",
    "lint:starfield": "oxlint games/starfield --deny-warnings",
    "dev:beasts": "vite --config games/beasts/vite.config.ts",
    "build:beasts": "vue-tsc --noEmit -p games/beasts/tsconfig.json && vite build --config games/beasts/vite.config.ts",
    "test:beasts": "vitest run --config games/beasts/vite.config.ts",
    "lint:beasts": "oxlint games/beasts --deny-warnings",
    "dev:camp": "vite --config games/camp/vite.config.ts",
    "build:camp": "vue-tsc --noEmit -p games/camp/tsconfig.json && vite build --config games/camp/vite.config.ts",
    "test:camp": "vitest run --config games/camp/vite.config.ts",
    "lint:camp": "oxlint games/camp --deny-warnings"
  },
  "dependencies": {
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "oxlint": "1.73.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
