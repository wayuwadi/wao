[Unit]
Description=WAO Jenkins UI and webhook reverse SSH tunnel
After=network-online.target jenkins.service
Wants=network-online.target
# 反向转发不依赖 Jenkins 端口在整个连接周期内可用。备份会短暂停止
# Jenkins；隧道必须保持运行，待控制器恢复后继续接收 UI 和 Webhook 流量。

[Service]
Type=simple
User=jenkins
Group=jenkins
ExecStart=/usr/bin/ssh -F /etc/jenkins/tunnel-ssh-config -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 127.0.0.1:18081:127.0.0.1:8081 wao-cloud-webhook
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
