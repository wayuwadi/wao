[Unit]
Description=WAO Jenkins runtime and queue health
After=jenkins.service

[Service]
Type=oneshot
User=jenkins
Group=jenkins
ExecStart=/usr/bin/python3 /usr/local/lib/wao-jenkins/controller-health.py --recover
StateDirectory=wao-jenkins-health
StateDirectoryMode=0700
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
