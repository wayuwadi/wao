# HISTORICAL THREE-NODE EXAMPLE: Linux1 is retired. Do not deploy this example
# or copy its replication factor and node addresses. See deploy/storage/README.md.
# Generate a fresh 32-byte hex rpc_secret outside Git before any approved deployment.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
metadata_auto_snapshot_interval = "6h"
replication_factor = 3
compression_level = 2
rpc_bind_addr = "10.66.0.2:3901"
rpc_public_addr = "10.66.0.2:3901"
rpc_secret = "<generated-shared-secret>"

[s3_api]
s3_region = "garage"
api_bind_addr = "10.66.0.2:3900"
