[Unit]
Description=WAO infrastructure inventory and resource history
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/wao-infrastructure/server.py
Restart=always
RestartSec=10
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/wao-infrastructure
PrivateTmp=true
MemoryMax=192M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
