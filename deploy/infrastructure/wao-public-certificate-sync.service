[Unit]
Description=Retry delivery of the current WAO public node certificate
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3h
StartLimitBurst=3

[Service]
Type=oneshot
Environment=RENEWED_LINEAGE=/etc/letsencrypt/live/wao-linux1-public
ExecStart=/etc/letsencrypt/renewal-hooks/deploy/wao-node-certificate.sh
UMask=0077
TimeoutStartSec=5m
Restart=on-failure
RestartSec=15m
