# Linux1 主动连接 Linux2：同时提供 Jenkins 反向入口和 Codex VPN 本地出口。
# 复制前替换“用户名”、SSH 私钥路径、Linux2 地址以及 Linux2 本机代理端口。

[Unit]
Description=WAO Linux1 reverse SSH and Codex egress tunnel to Linux2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 先把同目录 wao-linux2-tunnel.py 安装到 ~/.local/libexec/；仅解析连接地址，密钥身份仍使用域名。
ExecStart=/usr/bin/python3 /home/用户名/.local/libexec/wao-linux2-tunnel.py \
  --identity /home/用户名/.ssh/id_ed25519_wao_linux2_tunnel \
  --known-hosts /home/用户名/.ssh/known_hosts \
  --host linux2.wayuwa.cn \
  --egress-port 7897
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
