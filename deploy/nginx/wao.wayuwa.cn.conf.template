upstream wao_gateway {
    least_conn;
    # DDNS 同时发布 AAAA 时，云节点可能没有 IPv6 出站路由；渲染阶段只写入已验证的 IPv4。
    server ${MASTER_GATEWAY_IPV4}:9000${MASTER_GATEWAY_STATE} max_fails=3 fail_timeout=10s;
    server ${SLAVE_GATEWAY_IPV4}:9000${SLAVE_GATEWAY_STATE} max_fails=3 fail_timeout=10s;
    keepalive 32;
}

# Codex/OpenAI 的设备码、令牌刷新和额度查询需要从已配置 VPN 的 Linux 主节点出站。
# 这里不配置从节点 backup：主节点不可用时应明确失败，不能静默回退到受区域限制的出口。
upstream wao_ai_gateway {
    server ${MASTER_GATEWAY_IPV4}:9000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name wao.wayuwa.cn;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name wao.wayuwa.cn;

    ssl_certificate /etc/letsencrypt/live/wao.wayuwa.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wao.wayuwa.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # GitHub can reach only the signed webhook receiver. Keep its public path
    # stable while Jenkins itself runs below the /jenkins context path.
    location = /github-webhook/ {
        limit_except POST { deny all; }
        client_max_body_size 2m;
        proxy_pass http://127.0.0.1:18081/jenkins/github-webhook/;
        proxy_intercept_errors on;
        error_page 403 404 = @legacy_jenkins_webhook;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
    }

    # 首次切换 context path 时，云 Nginx 会先于当前 Jenkins 构建完成发布；
    # 在控制器 safeRestart 生效前保留旧 Webhook 路径，避免短暂漏接 push。
    location @legacy_jenkins_webhook {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
    }

    # Jenkins remains bound to Linux loopback. This internal subrequest validates
    # the WAO session and returns server-derived identity/role headers for SSO.
    location = /_wao_jenkins_auth {
        internal;
        proxy_pass https://wao_gateway/api/auth/jenkins;
        proxy_ssl_verify off;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_next_upstream error timeout http_500 http_502 http_503 http_504;
    }

    location = /jenkins {
        return 308 /jenkins/;
    }

    # 只允许无响应正文的 HEAD 探针，供 safeRestart 后确认新 context path 已真正生效。
    location = /jenkins-health {
        if ($request_method != HEAD) { return 405; }
        proxy_pass http://127.0.0.1:18081/jenkins/login;
        proxy_method HEAD;
        proxy_pass_request_body off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /jenkins/ {
        auth_request /_wao_jenkins_auth;
        auth_request_set $wao_jenkins_user $upstream_http_x_wao_jenkins_user;
        auth_request_set $wao_jenkins_groups $upstream_http_x_wao_jenkins_groups;
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Never trust identity or credentials supplied by the browser. Only the
        # values returned by WAO's internal auth subrequest reach Jenkins.
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-User $wao_jenkins_user;
        proxy_set_header X-Forwarded-Groups $wao_jenkins_groups;
        proxy_set_header X-Forwarded-Mail "";
        proxy_set_header X-Forwarded-DisplayName "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # JumpServer SSO tickets are signed only on the Linux node that owns the
    # matching private deployment secret. Do not send this endpoint to the slave.
    location = /api/auth/jumpserver {
        proxy_pass https://wao_ai_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_next_upstream off;
        add_header X-WAO-API-Route linux-jumpserver-sso always;
    }

    # Same-origin health probe for the configurable external-app view. Browsers
    # must not depend on cross-origin CORS support from JumpServer itself.
    location = /api/external/jumpserver/health {
        proxy_pass http://127.0.0.1:18082/api/health/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host jms.wayuwa.cn;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        add_header X-WAO-API-Route jumpserver-health-tunnel always;
    }

    location = /_wao_infrastructure_auth {
        internal;
        proxy_pass https://wao_gateway/api/auth/infrastructure;
        proxy_ssl_verify off;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }
    location = /api/infrastructure/overview {
        auth_request /_wao_infrastructure_auth;
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:18782/overview;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        add_header Cache-Control "no-store" always;
    }

    # WeKnora uses an isolated runtime on Linux2. Every entry, API and file
    # request must pass WAO authentication before reaching that runtime.
    location = /_wao_weknora_auth {
        internal;
        proxy_pass https://wao_gateway/api/auth/session;
        proxy_ssl_verify off;
        proxy_pass_request_body off;
        # The session endpoint returns JSON; an SSE client's Accept header
        # must not cause Spring content negotiation to reject this subrequest.
        proxy_set_header Accept "application/json";
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }
    # Machine ingestion is independent from browser sessions. Only official
    # knowledge routes are exposed; a scoped WeKnora API key authenticates each call.
    location ~ "^/api/weknora-machine/(knowledge-bases/[0-9a-fA-F-]{36}(/knowledge(/manual)?)?|knowledge/(manual/)?[0-9a-fA-F-]{36})$" {
        if ($http_x_api_key = "") { return 401; }
        limit_except GET POST PUT DELETE { deny all; }
        rewrite ^/api/weknora-machine/(.*)$ /api/v1/$1 break;
        proxy_pass http://127.0.0.1:18781;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header Host $host;
        proxy_set_header X-API-Key $http_x_api_key;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_read_timeout 50s;
        client_max_body_size 1m;
        add_header Cache-Control "no-store" always;
    }
    location /api/weknora-machine/ { return 404; }
    location = /weknora { return 308 /weknora/; }
    location ^~ /weknora/ {
        auth_request /_wao_weknora_auth;
        proxy_pass http://127.0.0.1:18781/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 50m;
        add_header Cache-Control "no-store" always;
    }
    location ^~ /api/v1/ {
        auth_request /_wao_weknora_auth;
        proxy_pass http://127.0.0.1:18781;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 50m;
        add_header Cache-Control "no-store" always;
    }
    location = /files {
        # Preserve WAO's native /files page; WeKnora legacy downloads always carry file_path.
        if ($arg_file_path = "") { rewrite ^ /index.html last; }
        auth_request /_wao_weknora_auth;
        proxy_pass http://127.0.0.1:18781;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 50m;
        add_header Cache-Control "no-store" always;
    }
    location ^~ /r/ {
        auth_request /_wao_weknora_auth;
        proxy_pass http://127.0.0.1:18781;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 50m;
        add_header Cache-Control "no-store" always;
    }
    location = /api/external/weknora/health {
        auth_request /_wao_weknora_auth;
        proxy_pass http://127.0.0.1:18781/api/v1/auth/config;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 50m;
        add_header Cache-Control "no-store" always;
    }

    root /var/www/wao/dist;
    index index.html;

    location = /_edge/routing.json {
        alias /etc/wao-public-edge/routing.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
    }
    location = /edge-static-worker.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
    }
    location = /edge-bootstrap.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # Same release identity on home nodes and cloud fallback; missing chunks
    # must remain 404 instead of returning a different release or SPA HTML.
    location ~ "^/releases/[0-9a-f]{40}/(?:assets/[^.][^\\?]*|release-manifest\.json)$" {
        root /var/www/wao;
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location /releases/ { return 404; }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /pluginWebUpdateNotice/web_version_by_plugin.json {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # 移动安装包独立保存；清单最后切换，版本目录不可变，缺失文件禁止回落 SPA。
    location = /downloads/mobile/latest.json {
        alias /var/www/wao-downloads/mobile/latest.json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location ^~ /downloads/mobile/ {
        alias /var/www/wao-downloads/mobile/;
        try_files $uri =404;
        types { application/vnd.android.package-archive apk; application/octet-stream ipa; text/plain txt; }
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Disposition attachment;
        add_header X-Content-Type-Options nosniff always;
    }

    # 工作区客户端独立于桌宠；更新清单和固定下载地址不可被父级 immutable 缓存。
    location = /downloads/desktop/client/latest.json {
        alias /var/www/wao-downloads/desktop/client/latest.json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /downloads/desktop/client/WAO-windows-x64-setup.exe {
        alias /var/www/wao-downloads/desktop/client/WAO-windows-x64-setup.exe;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /downloads/desktop/client/WAO-macos-universal.dmg {
        alias /var/www/wao-downloads/desktop/client/WAO-macos-universal.dmg;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # 桌面宠物安装包与签名更新包独立于 Web dist 生命周期；发布清单最后原子替换且禁止缓存。
    location = /downloads/desktop/latest.json {
        alias /var/www/wao-downloads/desktop/latest.json;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Content-Type-Options nosniff always;
    }

    location = /downloads/desktop/WAO-Pet-windows-x64-setup.exe {
        alias /var/www/wao-downloads/desktop/WAO-Pet-windows-x64-setup.exe;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Content-Type-Options nosniff always;
    }

    location = /downloads/desktop/WAO-Pet-macos-universal.dmg {
        alias /var/www/wao-downloads/desktop/WAO-Pet-macos-universal.dmg;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Content-Type-Options nosniff always;
    }

    location ^~ /downloads/desktop/ {
        alias /var/www/wao-downloads/desktop/;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    location = /agent {
        return 301 /agent/;
    }

    # Agent 与 WAO 同仓发布，但静态目录继续隔离，便于独立加载和故障隔离。
    location /agent/ {
        alias /var/www/wao-agent/dist/;
        try_files $uri $uri/ /agent/index.html;
    }

    location /agent/assets/ {
        alias /var/www/wao-agent/dist/assets/;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /agent/index.html {
        alias /var/www/wao-agent/dist/index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Amer 风险管理演示是随主站制品发布的独立静态页面；精确前缀避免落入 WAO SPA。
    location = /amer_demo_1 {
        return 308 /amer_demo_1/;
    }

    location ^~ /amer_demo_1/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # 第二版只依据客户原始需求，继续以独立静态前缀与第一版并存。
    location = /amer_demo_2 {
        return 308 /amer_demo_2/;
    }

    location ^~ /amer_demo_2/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # 第三版反映最新客户访谈：安全部门集中维护、Owner 只读、Assessment 版本历史。
    location = /amer_demo_3 {
        return 308 /amer_demo_3/;
    }

    location ^~ /amer_demo_3/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # V4 同步本地 V3 的交互修复；原 V3 路径继续提供同版内容。
    location = /amer_demo_4 {
        return 308 /amer_demo_4/;
    }

    location ^~ /amer_demo_4/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    location = /amer_demo_5 {
        return 308 /amer_demo_5/;
    }

    location ^~ /amer_demo_5/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # V6 固化 V5 基础资源并叠加状态、评估和 Action 交互优化。
    location = /amer_demo_6 {
        return 308 /amer_demo_6/;
    }

    location ^~ /amer_demo_6/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # 旧游戏入口收敛到 WAO 原生游戏厅；无真实接口的 Insight 明确退役。
    location = /game {
        return 308 /games;
    }

    location ^~ /game/ {
        return 308 /games;
    }

    location = /insight {
        return 410;
    }

    location ^~ /insight/ {
        return 410;
    }

    # 真正独立的第三方应用仍可维护自己的静态路由片段。
    include /etc/nginx/wao-external-apps.d/*.conf;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 任务建议挖掘复用本地 Codex 只读队列，和页面 AI 助手保持同一五分钟等待窗口；
    # 只写共享数据库，可由任一 Gateway 处理，但写请求不得在超时后自动重放。
    location = /api/ai/evolution/suggestions/refresh {
        proxy_pass https://wao_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 330s;
        proxy_send_timeout 120s;
        proxy_next_upstream off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route dual-gateway-ai-long always;
    }

    # 内容素材的上传、列表和预览固定到 Linux 主节点，确保编辑器读取上传时使用同一媒体卷。
    location ^~ /api/agent/publish/media {
        proxy_pass https://wao_ai_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 330s;
        proxy_send_timeout 330s;
        proxy_next_upstream off;
        client_max_body_size 320m;
        proxy_request_buffering off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route linux-master-agent-media always;
    }

    # 视频工作流的 WebM 上传、回放和元数据固定到 Linux 主节点，确保同一媒体卷可见。
    # 浏览器本地实时编码约三分钟；这里只传文件，不调用模型，也不允许写请求被自动重放。
    location ^~ /api/agent/video-workflow {
        proxy_pass https://wao_ai_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 330s;
        proxy_send_timeout 330s;
        proxy_next_upstream off;
        client_max_body_size 320m;
        proxy_request_buffering off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route linux-master-video-workflow always;
    }

    # 每日情境建议同样复用本地 Codex 五分钟只读队列；POST 生成不能在超时后自动重放。
    # GET 也走同一精确路径，延长读取上限不会触发模型调用。
    location = /api/daily-guidance {
        proxy_pass https://wao_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 330s;
        proxy_send_timeout 120s;
        proxy_next_upstream off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route dual-gateway-ai-long always;
    }

    # 周报生成只写入短期只读分析队列，最长等待五分钟；POST 不允许超时后自动重放。
    location = /api/weekly-report/generate {
        proxy_pass https://wao_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 330s;
        proxy_send_timeout 120s;
        proxy_next_upstream off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route dual-gateway-ai-long always;
    }

    # 人生回顾生成复用本地 Codex 五分钟只读队列；POST 不允许超时后自动重放。
    location = /api/life-reviews/generate {
        proxy_pass https://wao_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 330s;
        proxy_send_timeout 120s;
        proxy_next_upstream off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route dual-gateway-ai-long always;
    }

    # AI 编排接口只访问共享数据库，读写都使用双 Gateway；入队只校验账号元数据，
    # 真正的凭据读取和令牌续期延后到下面固定走 Linux 的 Runner 领取接口。
    location ~ ^/api/ai/(?:workflows|goals|runners|runners/[^/]+/log|runs|tasks/[^/]+/runs|projects/[^/]+/config)$ {
        proxy_pass https://wao_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 120s;
        proxy_next_upstream error timeout http_500 http_502 http_503 http_504;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route dual-gateway-ai always;
    }

    # 微信公众号令牌受出口 IP 白名单约束；认证、回调和配置验证统一固定到 Linux 主节点，
    # 避免双节点轮流要求不同白名单。配置读取与保存仍走共享数据库和普通双节点。
    location ~ ^/api/(?:auth/wechat/official(?:/|$)|settings/login/wechat-official/verify$) {
        proxy_pass https://wao_ai_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_next_upstream off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route wechat-official-master always;
    }

    # 只有会读取集中凭据或访问供应商的接口固定到 Linux VPN 出口。AI 入队、目标创建、状态轮询、
    # Runner 心跳和结果回传都是共享数据库操作，继续走下方双节点 upstream，避免主节点发布时整条链路 502。
    # 天人解读是长连接专用链路，按 ADR-047 保持 Linux 主节点和 330 秒超时。
    location ~ ^/api/(settings/ai-accounts(?:/|$)|ai/runner/(?:accounts|claim|assistant-v2/claim)(?:/|$)|tianren/readings/today/interpret(?:/|$)) {
        proxy_pass https://wao_ai_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        # 聊天记录检索会增加 Codex 上下文，和服务端五分钟等待窗口保持余量。
        proxy_read_timeout 330s;
        proxy_send_timeout 120s;
        proxy_next_upstream off;
        # 本 location 定义了诊断头后不会继承 server 级 add_header，因此安全头在这里显式保留。
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route linux-vpn-master always;
    }

    location /api/ {
        proxy_pass https://wao_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout http_500 http_502 http_503 http_504;

        # 图床上传要放行大请求体（默认 1m 会让 10MB 的截图直接 413），
        # 上传本身也比普通接口慢，读写超时单独放宽。
        client_max_body_size 52m;
        proxy_request_buffering off;
        proxy_send_timeout 120s;
    }
}
