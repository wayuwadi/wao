upstream wao_gateway {
    least_conn;
    server ${MASTER_PUBLIC_HOST}:9000 max_fails=3 fail_timeout=10s;
    server ${SLAVE_PUBLIC_HOST}:9000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

# Codex/OpenAI 的设备码、令牌刷新和额度查询需要从已配置 VPN 的 Linux 主节点出站。
# 这里不配置从节点 backup：主节点不可用时应明确失败，不能静默回退到受区域限制的出口。
upstream wao_ai_gateway {
    server ${MASTER_PUBLIC_HOST}:9000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name wao.wayuwa.cn;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name wao.wayuwa.cn;

    ssl_certificate /etc/letsencrypt/live/wao.wayuwa.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wao.wayuwa.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    root /var/www/wao/dist;
    index index.html;

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /agent {
        return 301 /agent/;
    }

    # Agent 前端由独立仓库发布到单独静态目录，WAO 发布不会覆盖它。
    location /agent/ {
        alias /var/www/wao-agent/dist/;
        try_files $uri $uri/ /agent/index.html;
    }

    location /agent/assets/ {
        alias /var/www/wao-agent/dist/assets/;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /agent/index.html {
        alias /var/www/wao-agent/dist/index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # 独立应用各自维护静态路由片段；WAO 发布只保留入口，不覆盖片段内容。
    include /etc/nginx/wao-external-apps.d/*.conf;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # AI 账号管理、运行入队和 Runner 领取都可能触发 Codex 令牌刷新或额度查询，统一固定到 Linux。
    location ~ ^/api/(settings/ai-accounts(?:/|$)|ai(?:/|$)) {
        proxy_pass https://wao_ai_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_next_upstream off;
        # 本 location 定义了诊断头后不会继承 server 级 add_header，因此安全头在这里显式保留。
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route linux-vpn-master always;
    }

    location /api/ {
        proxy_pass https://wao_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout http_500 http_502 http_503 http_504;

        # 图床上传要放行大请求体（默认 1m 会让 10MB 的截图直接 413），
        # 上传本身也比普通接口慢，读写超时单独放宽。
        client_max_body_size 52m;
        proxy_request_buffering off;
        proxy_send_timeout 120s;
    }
}
