map $uri $wao_ready_trace {
    default 0;
    /api/edge/ready 1;
}

# Log only the readiness route's selected upstream and timing. Keep the
# ordinary access log as well; neither log includes query strings or cookies.
log_format wao_ready_upstream 'time=$time_iso8601 client=$remote_addr status=$status '
                              'upstream=$upstream_addr upstream_status=$upstream_status '
                              'request_time=$request_time upstream_time=$upstream_response_time';

upstream wao_gateway {
    least_conn;
    # DDNS 同时发布 AAAA 时，云节点可能没有 IPv6 出站路由；渲染阶段只写入已验证的 IPv4。
${WAO_GATEWAY_SERVERS}
    keepalive 32;
}

# Codex/OpenAI 的设备码、令牌刷新和额度查询需要从已配置 VPN 的 Linux 主节点出站。
# 这里不配置从节点 backup：主节点不可用时应明确失败，不能静默回退到受区域限制的出口。
upstream wao_ai_gateway {
    server ${MASTER_GATEWAY_IPV4}:9000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name wao.wayuwa.cn;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;

    # BEGIN WAO GAME ASSETS v1
    location = /play-assets/catalog.json {
        alias /var/www/wao/play-assets/catalog.json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~ "^/play-assets/(dino|rift|starfield|beasts)/([0-9a-f]{40})/(index\.html|game-manifest\.json|assets/[A-Za-z0-9_.-]+\.(?:js|css|png|jpg|webp|svg|woff2|ogg|mp3))$" {
        alias /var/www/wao/play-assets/$1/$2/$3;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
    }
    # Explicit fallback prevents unknown paths from receiving the main SPA shell.
    location /play-assets/ { return 404; }
    # END WAO GAME ASSETS v1

    listen [::]:443 ssl http2;
    server_name wao.wayuwa.cn;

    ssl_certificate /etc/letsencrypt/live/wao.wayuwa.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wao.wayuwa.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # GitHub can reach only the signed webhook receiver. Keep its public path
    # stable while Jenkins itself runs below the /jenkins context path.
    location = /github-webhook/ {
        limit_except POST { deny all; }
        client_max_body_size 2m;
        proxy_pass http://127.0.0.1:18081/jenkins/github-webhook/;
        proxy_intercept_errors on;
        error_page 403 404 = @legacy_jenkins_webhook;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
    }

    # 首次切换 context path 时，云 Nginx 会先于当前 Jenkins 构建完成发布；
    # 在控制器 safeRestart 生效前保留旧 Webhook 路径，避免短暂漏接 push。
    location @legacy_jenkins_webhook {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
    }

    # Jenkins remains bound to Linux loopback. This internal subrequest validates
    # the WAO session and returns server-derived identity/role headers for SSO.
    location = /_wao_jenkins_auth {
        internal;
        proxy_pass https://wao_gateway/api/auth/jenkins;
        proxy_ssl_verify off;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_next_upstream error timeout http_500 http_502 http_503 http_504;
    }

    location = /jenkins {
        return 308 /jenkins/;
    }

    # 只允许无响应正文的 HEAD 探针，供 safeRestart 后确认新 context path 已真正生效。
    location = /jenkins-health {
        if ($request_method != HEAD) { return 405; }
        proxy_pass http://127.0.0.1:18081/jenkins/login;
        proxy_method HEAD;
        proxy_pass_request_body off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /jenkins/ {
        auth_request /_wao_jenkins_auth;
        auth_request_set $wao_jenkins_user $upstream_http_x_wao_jenkins_user;
        auth_request_set $wao_jenkins_groups $upstream_http_x_wao_jenkins_groups;
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Never trust identity or credentials supplied by the browser. Only the
        # values returned by WAO's internal auth subrequest reach Jenkins.
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-User $wao_jenkins_user;
        proxy_set_header X-Forwarded-Groups $wao_jenkins_groups;
        proxy_set_header X-Forwarded-Mail "";
        proxy_set_header X-Forwarded-DisplayName "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # JumpServer SSO tickets are signed on Linux2, which owns the private deployment secret.
    location = /api/auth/jumpserver { return 410; }

    # Same-origin health probe for the configurable external-app view. Browsers
    # must not depend on cross-origin CORS support from JumpServer itself.
    location = /api/external/jumpserver/health { return 410; }

    # WeKnora 已退役；保留 WAO 本身的 /files 页面。
    location = /weknora { return 410; }
    location ^~ /weknora/ { return 410; }
    location ^~ /api/v1/ { return 410; }
    location ^~ /api/weknora-machine/ { return 410; }
    location = /api/external/weknora/health { return 410; }
    location = /files {
        if ($arg_file_path != "") { return 410; }
        rewrite ^ /index.html last;
    }
    location ^~ /r/ { return 410; }

    root /var/www/wao/dist;
    index index.html;

    location = /_edge/routing.json {
        alias /etc/wao-public-edge/routing.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
    }
    location = /edge-static-worker.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
    }
    location = /edge-bootstrap.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # Same release identity on home nodes and cloud fallback; missing chunks
    # must remain 404 instead of returning a different release or SPA HTML.
    location ~ "^/releases/[0-9a-f]{40}/(?:assets/[^.][^\\?]*|release-manifest\.json)$" {
        root /var/www/wao;
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location /releases/ { return 404; }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /pluginWebUpdateNotice/web_version_by_plugin.json {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # 移动安装包独立保存；清单最后切换，版本目录不可变，缺失文件禁止回落 SPA。
    location = /downloads/mobile/latest.json {
        alias /var/www/wao-downloads/mobile/latest.json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location ^~ /downloads/mobile/ {
        alias /var/www/wao-downloads/mobile/;
        try_files $uri =404;
        types { application/vnd.android.package-archive apk; application/octet-stream ipa; text/plain txt; }
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Disposition attachment;
        add_header X-Content-Type-Options nosniff always;
    }

    # 工作区客户端独立于桌宠；更新清单和固定下载地址不可被父级 immutable 缓存。
    location = /downloads/desktop/client/latest.json {
        alias /var/www/wao-downloads/desktop/client/latest.json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /downloads/desktop/client/WAO-windows-x64-setup.exe {
        alias /var/www/wao-downloads/desktop/client/WAO-windows-x64-setup.exe;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /downloads/desktop/client/WAO-macos-universal.dmg {
        alias /var/www/wao-downloads/desktop/client/WAO-macos-universal.dmg;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # 桌面宠物安装包与签名更新包独立于 Web dist 生命周期；发布清单最后原子替换且禁止缓存。
    location = /downloads/desktop/latest.json {
        alias /var/www/wao-downloads/desktop/latest.json;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Content-Type-Options nosniff always;
    }

    location = /downloads/desktop/WAO-Pet-windows-x64-setup.exe {
        alias /var/www/wao-downloads/desktop/WAO-Pet-windows-x64-setup.exe;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Content-Type-Options nosniff always;
    }

    location = /downloads/desktop/WAO-Pet-macos-universal.dmg {
        alias /var/www/wao-downloads/desktop/WAO-Pet-macos-universal.dmg;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Content-Type-Options nosniff always;
    }

    location ^~ /downloads/desktop/ {
        alias /var/www/wao-downloads/desktop/;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    # WAO Agent 已退役，历史静态地址与专属 API 明确返回 410。
    location = /agent { return 410; }
    location ^~ /agent/ { return 410; }
    location = /api/agent { return 410; }
    location ^~ /api/agent/ { return 410; }

    # Amer 风险管理演示是随主站制品发布的独立静态页面；精确前缀避免落入 WAO SPA。
    location = /amer_demo_1 {
        return 308 /amer_demo_1/;
    }

    location ^~ /amer_demo_1/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # 第二版只依据客户原始需求，继续以独立静态前缀与第一版并存。
    location = /amer_demo_2 {
        return 308 /amer_demo_2/;
    }

    location ^~ /amer_demo_2/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # 第三版反映最新客户访谈：安全部门集中维护、Owner 只读、Assessment 版本历史。
    location = /amer_demo_3 {
        return 308 /amer_demo_3/;
    }

    location ^~ /amer_demo_3/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # V4 同步本地 V3 的交互修复；原 V3 路径继续提供同版内容。
    location = /amer_demo_4 {
        return 308 /amer_demo_4/;
    }

    location ^~ /amer_demo_4/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    location = /amer_demo_5 {
        return 308 /amer_demo_5/;
    }

    location ^~ /amer_demo_5/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # V6 固化 V5 基础资源并叠加状态、评估和 Action 交互优化。
    location = /amer_demo_6 {
        return 308 /amer_demo_6/;
    }

    location ^~ /amer_demo_6/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # V7 精简主导航和 Risk 详情页签，继续保留独立静态边界。
    location = /amer_demo_7 {
        return 308 /amer_demo_7/;
    }

    location ^~ /amer_demo_7/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # 625 word 使用 WAO 隔离的单文件网页托管入口。
    location = /625word {
        return 302 /api/pages/625word;
    }

    location = /insight {
        return 410;
    }

    location ^~ /insight/ {
        return 410;
    }

    # 真正独立的第三方应用仍可维护自己的静态路由片段。
    include /etc/nginx/wao-external-apps.d/*.conf;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 任务建议挖掘复用本地 Codex 只读队列，和页面 AI 助手保持同一五分钟等待窗口；
    # 只写共享数据库，可由任一 Gateway 处理，但写请求不得在超时后自动重放。
    location = /api/ai/evolution/suggestions/refresh {
        proxy_pass https://wao_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 330s;
        proxy_send_timeout 120s;
        proxy_next_upstream off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route dual-gateway-ai-long always;
    }

    # 内容素材的上传、列表和预览固定到 Linux 主节点，确保编辑器读取上传时使用同一媒体卷。

    # 视频工作流的 WebM 上传、回放和元数据固定到 Linux 主节点，确保同一媒体卷可见。
    # 浏览器本地实时编码约三分钟；这里只传文件，不调用模型，也不允许写请求被自动重放。

    # 每日情境建议同样复用本地 Codex 五分钟只读队列；POST 生成不能在超时后自动重放。
    # GET 也走同一精确路径，延长读取上限不会触发模型调用。
    location = /api/daily-guidance {
        proxy_pass https://wao_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 330s;
        proxy_send_timeout 120s;
        proxy_next_upstream off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route dual-gateway-ai-long always;
    }

    # 人生回顾生成复用本地 Codex 五分钟只读队列；POST 不允许超时后自动重放。
    location = /api/life-reviews/generate {
        proxy_pass https://wao_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 330s;
        proxy_send_timeout 120s;
        proxy_next_upstream off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route dual-gateway-ai-long always;
    }

    # AI 编排接口只访问共享数据库，读写都使用双 Gateway；入队只校验账号元数据，
    # 真正的凭据读取和令牌续期延后到下面固定走 Linux 的 Runner 领取接口。
    location ~ ^/api/ai/(?:workflows|goals|runners|runners/[^/]+/log|runs|tasks/[^/]+/runs|projects/[^/]+/config)$ {
        proxy_pass https://wao_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 120s;
        proxy_next_upstream error timeout http_500 http_502 http_503 http_504;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route dual-gateway-ai always;
    }

    # 只有会读取集中凭据或访问供应商的接口固定到 Linux VPN 出口。AI 入队、目标创建、状态轮询、
    # Runner 心跳和结果回传都是共享数据库操作，继续走下方双节点 upstream，避免主节点发布时整条链路 502。
    # 天人解读是长连接专用链路，按 ADR-047 保持 Linux 主节点和 330 秒超时。
    location ~ ^/api/ai/(runner|runners)(/|$) { return 410; }

    location ~ ^/api/(settings/ai-accounts(?:/|$)|tianren/readings/today/interpret(?:/|$)) {
        proxy_pass https://wao_ai_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        # 聊天记录检索会增加 Codex 上下文，和服务端五分钟等待窗口保持余量。
        proxy_read_timeout 330s;
        proxy_send_timeout 120s;
        proxy_next_upstream off;
        # 本 location 定义了诊断头后不会继承 server 级 add_header，因此安全头在这里显式保留。
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-WAO-API-Route linux-vpn-master always;
    }

    location /api/ {
        access_log /var/log/nginx/access.log combined;
        access_log /var/log/nginx/wao-ready-upstream.log wao_ready_upstream if=$wao_ready_trace;
        proxy_pass https://wao_gateway;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout http_500 http_502 http_503 http_504;

        # multipart 基线放行 1GiB 文件及少量表单开销；业务文件仍限制 200MiB。
        client_max_body_size 1030m;
        proxy_request_buffering off;
        proxy_send_timeout 120s;
    }
}
