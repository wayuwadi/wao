server {
    listen 9443 ssl;
    listen [::]:9443 ssl;
    server_name ${WAO_EDGE_HOST};
    set $wao_edge_api_enabled "${WAO_EDGE_API_ENABLED}";
    ssl_certificate /etc/nginx/node-tls/current/fullchain.pem;
    ssl_certificate_key /etc/nginx/node-tls/current/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/json application/javascript image/svg+xml;
    # Immutable build assets only. No SPA fallback or user uploads.
    location ~ "^/releases/[0-9a-f]{40}/(?:assets/[^.][^\\?]*|release-manifest\.json)$" {
        root /srv/wao;
        try_files $uri =404;
        limit_except GET { deny all; }
        add_header Access-Control-Allow-Origin "https://wao.wayuwa.cn" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /_edge/health {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "https://wao.wayuwa.cn" always;
        return 200 '{"node":"${WAO_EDGE_NODE}","tlsReady":true,"businessRoutingEnabled":${WAO_EDGE_API_ENABLED}}';
    }
    # Explicit allowlist: login/OAuth, Agent, runner and anonymous download tickets
    # keep their existing main-domain contracts. API rollout is disabled by default.
    location ~ ^/api/(?:edge/(?:ready|exchange|session)$|(?:tasks|projects|areas|members|org|kbs|kb-groups|docs)(?:/|$)) {
        # Empty map keys leave business requests unaffected by the probe budget.
        limit_req zone=edge_probe burst=10 nodelay;
        limit_req_status 429;
        if ($wao_edge_api_enabled != "true") { return 503; }
        if ($host != "${WAO_EDGE_HOST}") { return 421; }
        if ($http_origin != "https://wao.wayuwa.cn") { return 403; }
        if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) { return 405; }
        add_header Access-Control-Allow-Origin "https://wao.wayuwa.cn" always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, X-WAO-CSRF" always;
        add_header Vary "Origin" always;
        add_header Cache-Control "no-store" always;
        if ($request_method = OPTIONS) { return 204; }
        client_max_body_size 52m;
        proxy_pass ${WAO_EDGE_GATEWAY_SCHEME}://${WAO_EDGE_GATEWAY};
        # Existing gateway uses a self-signed certificate on the local host only.
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host "${WAO_EDGE_HOST}:9443";
        proxy_set_header X-Forwarded-Host "${WAO_EDGE_HOST}:9443";
        proxy_set_header X-Forwarded-Port 9443;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 60s;
        proxy_next_upstream off;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
    }
    # Business and static routes are enabled only after their separate
    # authentication, version and fallback acceptance gates pass.
    location / { return 404; }
}
