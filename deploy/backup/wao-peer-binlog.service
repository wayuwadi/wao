[Unit]
Description=Encrypt and archive closed MySQL binary logs to the other Linux node
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/local/lib/wao-backup/archive-peer-binlogs.sh
Nice=15
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=512M
TimeoutStartSec=30min
