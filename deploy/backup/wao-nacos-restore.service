[Unit]
Description=Isolated Nacos recovery rehearsal on Linux1

[Service]
Type=oneshot
UMask=0077
Environment=WAO_PEER_SNAPSHOT_ROOT=%h/backups/wao-peer-nacos
Environment=WAO_PEER_VERIFY_SCRIPT=%h/.local/libexec/wao-backup/verify-nacos-recovery.sh
ExecStart=%h/.local/libexec/wao-backup/restore-latest-peer-backup.sh
TimeoutStartSec=15m
Nice=10
