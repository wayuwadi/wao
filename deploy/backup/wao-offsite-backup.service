[Unit]
Description=Publish readable WAO documents and tasks to 123 Cloud Drive
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/wao-backup/webdav.env
StartLimitIntervalSec=3h
StartLimitBurst=3

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/local/lib/wao-backup/run-readable-content.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=12h
Restart=on-failure
RestartSec=30m
