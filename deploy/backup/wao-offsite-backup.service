[Unit]
Description=Upload verified WAO peer recovery snapshot to 123 Cloud Drive
After=network-online.target wao-peer-backup.service
Wants=network-online.target
ConditionPathExists=/etc/wao-backup/webdav.env
ConditionPathExists=/etc/wao-backup/encryption-passphrase
StartLimitIntervalSec=3h
StartLimitBurst=3

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/local/lib/wao-backup/upload-peer-offsite.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=12h
Restart=on-failure
RestartSec=30m
