[Unit]
Description=Independent Linux1 Nacos backup freshness alarm

[Service]
Type=oneshot
UMask=0077
Environment=WAO_PEER_SNAPSHOT_ROOT=%h/backups/wao-peer-nacos
Environment=WAO_PEER_ALARM_STATE=%h/.local/state/wao-peer-backup/nacos-alarm.json
ExecStart=%h/.local/libexec/wao-backup/check-peer-backup.sh --label Nacos
TimeoutStartSec=1m
