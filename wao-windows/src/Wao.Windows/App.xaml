<Application x:Class="Wao.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="InkBrush" Color="#172033"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#697386"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B5CE2"/>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="#EEF0FF"/>
      <Setter Property="Foreground" Value="#3537A6"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="BorderBrush" Value="#DCE0E8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="BorderBrush" Value="#DCE0E8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
    </Style>
  </Application.Resources>
</Application>
