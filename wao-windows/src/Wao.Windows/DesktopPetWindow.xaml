<Window x:Class="Wao.Windows.DesktopPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="176" Height="190" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="打开 WAO" Click="Open_Click"/>
      <MenuItem Header="刷新状态" Click="Refresh_Click"/>
      <Separator/>
      <MenuItem Header="隐藏桌面宠物" Click="Hide_Click"/>
    </ContextMenu>
  </Window.ContextMenu>
  <Grid>
    <Border x:Name="Bubble" Background="#F7FFFFFF" CornerRadius="14" Padding="10,7"
            VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="166">
      <Border.Effect><DropShadowEffect BlurRadius="12" Opacity="0.18" ShadowDepth="2"/></Border.Effect>
      <TextBlock x:Name="MessageText" Text="今天也一起把事情做好。" FontSize="12"
                 TextWrapping="Wrap" TextAlignment="Center"/>
    </Border>
    <Canvas Width="112" Height="112" VerticalAlignment="Bottom">
      <Canvas.RenderTransform>
        <TranslateTransform x:Name="PetBounce"/>
      </Canvas.RenderTransform>
      <Ellipse Width="94" Height="24" Fill="#22000000" Canvas.Left="9" Canvas.Top="84"/>
      <Path Fill="#6667E8" Data="M18,47 C11,20 27,7 39,24 C49,16 64,16 74,24 C88,7 103,20 95,48 L96,71 C94,91 78,101 56,101 C34,101 17,91 16,71 Z"/>
      <Path Fill="#8C8DF2" Data="M22,42 L29,18 L43,34 Z M69,34 L84,18 L90,43 Z"/>
      <Ellipse Width="9" Height="13" Fill="White" Canvas.Left="35" Canvas.Top="53"/>
      <Ellipse Width="9" Height="13" Fill="White" Canvas.Left="69" Canvas.Top="53"/>
      <Ellipse Width="4" Height="7" Fill="#20243B" Canvas.Left="38" Canvas.Top="57"/>
      <Ellipse Width="4" Height="7" Fill="#20243B" Canvas.Left="72" Canvas.Top="57"/>
      <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M49,74 Q56,81 63,74"/>
      <Ellipse Width="10" Height="5" Fill="#FFACB8" Canvas.Left="23" Canvas.Top="69"/>
      <Ellipse Width="10" Height="5" Fill="#FFACB8" Canvas.Left="79" Canvas.Top="69"/>
    </Canvas>
  </Grid>
</Window>
