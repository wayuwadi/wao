<Window x:Class="Wao.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAO" Width="1180" Height="780" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F6F7FB" Loaded="Window_Loaded">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#4D5668"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="BorderBrush" Value="#E8EAF0"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid x:Name="LoginPanel" Background="#F6F7FB">
      <Border Width="430" Padding="42" Background="White" CornerRadius="22"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect><DropShadowEffect BlurRadius="38" Opacity="0.12" ShadowDepth="8"/></Border.Effect>
        <StackPanel>
          <Border Width="58" Height="58" CornerRadius="18" Background="#5B5CE2" HorizontalAlignment="Left">
            <TextBlock Text="W" Foreground="White" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="欢迎回到 WAO" FontSize="28" FontWeight="SemiBold" Margin="0,22,0,7"/>
          <TextBlock Text="原生 Windows 客户端直接连接你的真实工作空间。"
                     Foreground="{StaticResource MutedBrush}" Margin="0,0,0,25"/>
          <StackPanel x:Name="LoginMethodsPanel">
            <Button x:Name="FeishuLoginButton" Content="飞书扫码登录" Style="{StaticResource PrimaryButton}"
                    Click="FeishuLogin_Click"/>
            <Button x:Name="CancelFeishuButton" Content="取消扫码" Margin="0,8,0,0" Visibility="Collapsed"
                    Click="CancelFeishu_Click"/>
            <TextBlock x:Name="FeishuLoginStatusText"
                       Text="将在系统浏览器打开飞书官方扫码页，授权结果会安全返回 WAO。"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Grid Margin="0,22,0,20">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Height="1" Background="#E1E4EC" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="或使用邮箱" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,0"/>
              <Border Grid.Column="2" Height="1" Background="#E1E4EC" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="邮箱" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBox x:Name="EmailBox" AutomationProperties.Name="邮箱"/>
            <TextBlock Text="密码" FontWeight="SemiBold" Margin="0,18,0,7"/>
            <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="密码"/>
            <Button x:Name="LoginButton" Content="邮箱登录" Margin="0,18,0,0" Click="Login_Click"/>
            <TextBlock Text="密码只用于当前 HTTPS 登录请求，不会写入本机。会话由 Windows 当前用户加密保存。"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
          </StackPanel>
          <StackPanel x:Name="ClaimPanel" Visibility="Collapsed">
            <TextBlock Text="确认 WAO 成员" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="ClaimHintText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,15"/>
            <ComboBox x:Name="ClaimMemberBox" DisplayMemberPath="Name" Padding="10"
                      AutomationProperties.Name="要绑定的 WAO 成员"/>
            <Button x:Name="ClaimButton" Content="确认并登录" Style="{StaticResource PrimaryButton}"
                    Margin="0,14,0,0" Click="Claim_Click"/>
            <Button Content="返回登录方式" Margin="0,8,0,0" Click="BackToLogin_Click"/>
          </StackPanel>
          <TextBlock x:Name="LoginErrorText" Foreground="#C93C54" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="RestoringPanel" Background="#F6F7FB" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="180" Height="5"/>
        <TextBlock Text="正在恢复登录…" Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="ShellPanel" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="238"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#EEF1F7" BorderBrush="#E0E4EC" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="20,23,12,22">
              <Border Width="38" Height="38" Background="#5B5CE2" CornerRadius="12">
                <TextBlock Text="W" Foreground="White" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="WAO" FontWeight="Bold" FontSize="17"/>
                <TextBlock Text="Windows" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
            </StackPanel>
            <Button x:Name="ProjectsNav" Style="{StaticResource NavButton}" Content="▦   项目与任务" Tag="projects" Click="Navigate_Click"/>
            <Button x:Name="AiNav" Style="{StaticResource NavButton}" Content="✦   AI 运行" Tag="ai" Click="Navigate_Click"/>
            <Button x:Name="AutomationNav" Style="{StaticResource NavButton}" Content="↻   自动化" Tag="automation" Click="Navigate_Click"/>
            <Separator Margin="18,14" Background="#D9DDE6"/>
            <Button Style="{StaticResource NavButton}" Content="◉   显示桌面宠物" Click="ShowPet_Click"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="14,12,14,18">
            <TextBlock x:Name="MemberNameText" FontWeight="SemiBold" Margin="8,0,8,2"/>
            <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,8,8"/>
            <Button Content="退出登录" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#8A3A4A" Click="Logout_Click"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="74"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="36"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FAFBFD" BorderBrush="#E7E9EF" BorderThickness="0,0,0,1">
          <Grid Margin="28,0">
            <TextBlock x:Name="PageTitleText" Text="项目与任务" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="UpdateButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="45" Height="40" Padding="0" Background="Transparent" Click="Update_Click"
                    ToolTip="检查更新">
              <Grid>
                <TextBlock Text="↻" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse x:Name="UpdateDot" Width="9" Height="9" Fill="#F04D64" Stroke="White" StrokeThickness="2"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/>
              </Grid>
            </Button>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,10">
          <Grid x:Name="ProjectsPanel">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="320"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                  <DockPanel>
                    <TextBlock Text="项目" FontSize="17" FontWeight="SemiBold"/>
                    <Button Content="刷新" DockPanel.Dock="Right" Padding="8,4" Click="RefreshProjects_Click"/>
                  </DockPanel>
                  <TextBlock x:Name="ProjectsEmptyText" Text="暂无项目" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <ListBox x:Name="ProjectList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="ProjectList_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="7,8" Width="250">
                        <DockPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                          <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        </DockPanel>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,9,0,7"/>
                        <TextBlock Text="{Binding Goal}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
              <DockPanel>
                <TextBlock x:Name="TasksHeading" Text="任务" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,14"/>
                <TextBlock x:Name="TasksEmptyText" Text="选择一个项目查看任务" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="TaskItems">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#F8F9FC" CornerRadius="10" Padding="13" Margin="0,0,0,9">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                              <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11">
                                <Run Text="{Binding Pr}"/><Run Text=" · "/><Run Text="{Binding Due}"/>
                              </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding Status}" DataContext="{Binding}" Margin="12,0,0,0"
                                    Padding="10,6" Click="ToggleTask_Click"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>

          <Grid x:Name="AiPanel" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Margin="0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="GoalProjectBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="9"/>
                <TextBox x:Name="GoalTextBox" Grid.Column="2" MinHeight="42" AcceptsReturn="True" TextWrapping="Wrap"
                         AutomationProperties.Name="AI 目标" ToolTip="写清目标、约束和验收标准"/>
                <Button x:Name="LaunchGoalButton" Grid.Column="4" Content="派发目标" Style="{StaticResource PrimaryButton}" Click="LaunchGoal_Click"/>
              </Grid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                  <TextBlock Text="最近运行" FontSize="17" FontWeight="SemiBold"/>
                  <Button Content="刷新" DockPanel.Dock="Right" Padding="8,4" Click="RefreshAi_Click"/>
                </DockPanel>
                <TextBlock x:Name="AiEmptyText" Text="暂无 AI 运行" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="AiRunItems">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#F8F9FC" CornerRadius="10" Padding="14" Margin="0,0,0,9">
                          <StackPanel>
                            <DockPanel>
                              <TextBlock Text="{Binding TaskTitle}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="#5557CB" FontWeight="SemiBold"/>
                            </DockPanel>
                            <TextBlock Text="{Binding ProjectName}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding DisplayProgress}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding CreatedAt}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>

          <Grid x:Name="AutomationPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                  <TextBlock Text="自动化任务" FontSize="17" FontWeight="SemiBold"/>
                  <Button Content="刷新" DockPanel.Dock="Right" Padding="8,4" Click="RefreshAutomation_Click"/>
                </DockPanel>
                <TextBlock x:Name="AutomationEmptyText" Text="暂无自动化" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="AutomationItems">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#F8F9FC" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                              <DockPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="#5557CB" Margin="14,0"/>
                              </DockPanel>
                              <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                              <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0">
                                <Run Text="{Binding Schedule}"/><Run Text=" · "/><Run Text="{Binding Last}"/>
                              </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                              <Button Content="立即运行" Tag="run" DataContext="{Binding}" Click="AutomationAction_Click" Margin="0,0,7,0"/>
                              <Button Content="暂停 / 恢复" Tag="toggle" DataContext="{Binding}" Click="AutomationAction_Click" Margin="0,0,7,0"/>
                              <Button Content="重新授权" Tag="reauth" DataContext="{Binding}" Click="AutomationAction_Click">
                                <Button.Style>
                                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Status}" Value="待修复">
                                        <Setter Property="Visibility" Value="Visible"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                              </Button>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#FAFBFD" BorderBrush="#E7E9EF" BorderThickness="0,1,0,0">
          <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                     Margin="28,0" VerticalAlignment="Center" Text="已连接 WAO"/>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
