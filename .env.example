# Application
SPRING_PROFILES_ACTIVE=prod
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=<your-nacos-password>
NACOS_AUTH_TOKEN=<base64-token-at-least-32-bytes>
NACOS_AUTH_IDENTITY_KEY=<random-identity-key>
NACOS_AUTH_IDENTITY_VALUE=<random-identity-value>
NACOS_DISCOVERY_IP=<detected-public-ip>

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DB_NAME=wao
DB_USER=wao_app
DB_PASS=<your-db-password>
DB_ROOT_PASS=<your-root-password>
MYSQL_REPLICATION_USER=wao_repl
MYSQL_REPLICATION_PASSWORD=<your-replication-password>

# Private S3-compatible image/file objects. Keep mysql mode until Garage and
# both application nodes pass readback; retain-mysql supports a rolling rollback.
WAO_STORAGE_MODE=mysql
WAO_STORAGE_RETAIN_MYSQL=true
# Linux2 maintenance scripts use this endpoint; Compose uses the node-specific
# endpoints below so each application reads from its local Garage node.
WAO_STORAGE_ENDPOINT=
WAO_STORAGE_ENDPOINT_MASTER=http://10.66.0.2:3900
WAO_STORAGE_ENDPOINT_SLAVE=http://10.66.0.3:3900
WAO_STORAGE_REGION=garage
WAO_STORAGE_BUCKET=wao-assets
WAO_STORAGE_ACCESS_KEY=
WAO_STORAGE_SECRET_KEY=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=<your-redis-password>
REDIS_MASTER_NAME=wao-master
REDIS_MASTER_HOST=linux2.wayuwa.cn
REDIS_SENTINEL_NODES=linux2.wayuwa.cn:26379,linux1.wayuwa.cn:26379

# Node addresses
MASTER_PUBLIC_HOST=linux2.wayuwa.cn
SLAVE_PUBLIC_HOST=linux1.wayuwa.cn
MASTER_BIND_IP=0.0.0.0

# Gateway TLS
GATEWAY_SSL_ENABLED=true
GATEWAY_SSL_PASS=<your-keystore-password>

# Authentication (Phase 1)
JWT_SECRET=<at-least-32-random-bytes>

# Vault (AES-256-GCM key for the password vault; base64-encoded 32 bytes, same value on master and slave)
WAO_VAULT_KEY=<base64-32-byte-key>

# NetEase Cloud Music Open Platform (official OAuth; values must match the approved application)
NETEASE_MUSIC_ENABLED=false
NETEASE_MUSIC_APP_ID=<approved-app-id>
NETEASE_MUSIC_APP_SECRET=<approved-app-secret>
NETEASE_MUSIC_PRIVATE_KEY=<pkcs8-rsa-private-key>
NETEASE_MUSIC_REDIRECT_URI=https://wao.wayuwa.cn/api/music/netease/callback
NETEASE_MUSIC_FRONTEND_URL=https://wao.wayuwa.cn
NETEASE_MUSIC_CLIENT_TYPE=web
NETEASE_MUSIC_CHANNEL=<assigned-channel>
NETEASE_MUSIC_DEVICE_TYPE=<approved-device-type>
NETEASE_MUSIC_OS=<approved-os>
NETEASE_MUSIC_OS_VER=<truthful-os-version>
NETEASE_MUSIC_APP_VER=<x.x.x>
NETEASE_MUSIC_BRAND=<approved-brand>
NETEASE_MUSIC_MODEL=<approved-model>

# Feishu OAuth login (enterprise custom app; keep the real secret out of Git)
FEISHU_LOGIN_ENABLED=false
FEISHU_APP_ID=<your-feishu-app-id>
FEISHU_APP_SECRET=<your-feishu-app-secret>
FEISHU_REDIRECT_URI=https://wao.wayuwa.cn/api/auth/feishu/callback
FEISHU_FRONTEND_URL=https://wao.wayuwa.cn

# JumpServer CE Custom SSO (real secret is generated in deploy/.env.secrets on Linux)
JUMPSERVER_SSO_ENABLED=false
JUMPSERVER_SSO_SHARED_SECRET=<at-least-32-random-bytes>

# Deployment targets. Real values belong in GitHub Secrets or /opt/wao/.env.
MASTER_HOST=linux2.wayuwa.cn
SLAVE_HOST=linux1.wayuwa.cn
CLOUD_HOST=<cloud-hostname>
ALERT_WEBHOOK_URL=<optional-alert-webhook>
