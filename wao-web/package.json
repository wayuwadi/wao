    "@tiptap/pm": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@tiptap/vue-3": "^3.29.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.18.1",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "marked": "^18.0.7",
    "pinia": "^4.0.2",
    "remixicon": "^4.5.0",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
