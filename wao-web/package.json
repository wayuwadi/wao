{
  "name": "wao-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:drafts": "vitest run src/__tests__/documentDraftLifecycle.spec.ts src/__tests__/documentDraftRecovery.spec.ts src/__tests__/documentDrafts.spec.ts src/__tests__/KbDetailView.spec.ts src/__tests__/docPresenceVisibility.spec.ts --maxWorkers=2",
    "test:acceptance-tools": "node --test scripts/acceptance/*.node.mjs",
    "test:edge-static": "node --test scripts/edge-static.node.mjs",
    "dev:acceptance": "node scripts/acceptance/serve.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@tiptap/extension-code-block-lowlight": "3.29.0",
    "@tiptap/extension-details": "3.29.0",
    "@tiptap/extension-drag-handle-vue-3": "3.29.0",
    "@tiptap/extension-highlight": "3.29.0",
    "@tiptap/extension-image": "^3.29.0",
    "@tiptap/extension-link": "^3.29.0",
    "@tiptap/extension-mathematics": "3.29.0",
    "@tiptap/extension-placeholder": "^3.29.0",
    "@tiptap/extension-table": "3.29.0",
    "@tiptap/extension-task-item": "^3.29.0",
    "@tiptap/extension-task-list": "^3.29.0",
    "@tiptap/extension-text-align": "3.29.0",
    "@tiptap/extension-text-style": "3.29.0",
    "@tiptap/extension-underline": "3.29.0",
    "@tiptap/extension-unique-id": "3.29.0",
    "@tiptap/markdown": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@tiptap/vue-3": "^3.29.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.18.1",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "katex": "0.17.0",
    "lowlight": "3.3.0",
    "marked": "^18.0.7",
    "mermaid": "11.17.2",
    "pinia": "^4.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remixicon": "^4.5.0",
    "three": "0.184.0",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@plugin-web-update-notification/vite": "^2.1.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.184.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "fake-indexeddb": "^6.2.5",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.73.0",
    "prettier": "3.9.5",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.17"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "6.0.1"
    },
    "lodash-es": "4.18.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
